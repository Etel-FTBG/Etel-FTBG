# ETEL Taxi .env TEMPLATE -- safe to commit, contains no real secrets.
# Copy this to api/.env on the live server and fill in real values there --
# api/.env itself is gitignored and must never be committed.
#
# Generate a random secret for any *_SECRET/*_KEY value with, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"

DB_HOST=localhost
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_PREFIX=CHANGE_ME

# Shared cross-app SSO - same Etelid_sessions/Etelid_members tables every
# other Etel app reads. Requires this DB user to have SELECT access to
# EtelID's database (a separate MySQL grant).
ETELID_DB_NAME=etelid
ETELID_DB_PREFIX=Etelid_
ETELID_HOST=ethelmarket.com

# EtelID Service API - "Sign in with EtelID" for drivers/admins/officers.
# Must match the same shared secret already configured on EtelID's own
# plugin (SETUP-SSO-KEY.txt).
ETELID_SERVICE_KEY=CHANGE_ME
ETELID_SERVICE_URL=https://ethelmarket.com/EtelId/wp-json/etelid/v1

# Delivery -> EtelTaxi service bridge (ServiceController.php) - lets
# Delivery's NFC "driver details for traffic officer" check pull a
# driver's live association-dues status. Must match Delivery's own
# api/.env ETELTAXI_SERVICE_KEY value exactly - different secret from
# ETELID_SERVICE_KEY, it protects a different pairing.
ETELTAXI_SERVICE_KEY=CHANGE_ME

# Admin key for one-time maintenance endpoints (migrate.php, seed-admin.php,
# debug-db.php, cron/send_reminders.php's manual-trigger mode).
TAXI_ADMIN_KEY=CHANGE_ME

# Signs the daily verify-code / QR shown in the driver's app.
TAXI_QR_SIGNING_KEY=CHANGE_ME

# Web Push (driver payment reminders).
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY_PEM=CHANGE_ME
VAPID_SUBJECT=mailto:CHANGE_ME@example.com

# Optional - in-app file Updater tool login.
UPDATER_PASSWORD=CHANGE_ME

# Optional - not required for the core app, only if these integrations
# are actually wired up.
TOKEN_SECRET=CHANGE_ME
ETEL_OS_KEY=CHANGE_ME
GOOGLE_MAPS_API_KEY=CHANGE_ME
TELEBIRR_MERCHANT_ID=CHANGE_ME
TELEBIRR_API_KEY=CHANGE_ME
TELEBIRR_SECRET_KEY=CHANGE_ME
ABYSINIA_MERCHANT_ID=CHANGE_ME
ABYSINIA_API_KEY=CHANGE_ME
ABYSINIA_ACCOUNT_NO=CHANGE_ME
CBE_MERCHANT_ID=CHANGE_ME
CBE_ACCOUNT_NO=CHANGE_ME
FCM_SERVER_KEY=CHANGE_ME
AT_API_KEY=CHANGE_ME
AT_USERNAME=CHANGE_ME
TG_BOT_TOKEN=CHANGE_ME
TG_BOT_NAME=CHANGE_ME
TG_WEBHOOK_SECRET=CHANGE_ME
ETEL_PAY_SECRET=CHANGE_ME
