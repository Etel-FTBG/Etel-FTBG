# Copy this file to .env and fill in real values before running/building.
# Never commit the real .env file.

# The delivery backend's Google Maps key (same one used in delivery/api/.env),
# ideally issued as a separate Android-app-restricted key in Google Cloud Console
# rather than reusing the web-restricted key.
GOOGLE_MAPS_API_KEY=

# The live boot.php endpoint. Point at a staging copy if one exists; defaults
# to production if unset (see app.config.js).
ETEL_API_BASE_URL=https://ethelmarket.com/delivery/api/boot.php
