# Copy to .env on the server (EtelERP/.env). Never commit the real file.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ethelmfz_EtelERP
DB_USER=ethelmfz_EtelERP
DB_PASS=CHANGE_ME

ETELID_HOST=ethelmarket.com
# per-app key from EtelID: add {"app":"etelerp","key":"<40+ random chars>","scopes":["authenticate","resolve"]} to ETELID_SERVICE_KEYS in EtelID's wp-config.php
ETELID_SERVICE_KEY=CHANGE_ME_40_OR_MORE_RANDOM_CHARACTERS

# used once by install.php to create the tables; remove after install
INSTALL_KEY=CHANGE_ME_RANDOM
