        if ( isset( $_POST['org_email'] ) )   update_option( 'etelid_org_email', sanitize_email( wp_unslash( $_POST['org_email'] ) ) );
        if ( isset( $_POST['gold_accent'] ) ) update_option( 'etelid_brand_gold', sanitize_hex_color( wp_unslash( $_POST['gold_accent'] ) ) );
        if ( isset( $_POST['custom_css'] ) )  update_option( 'etelid_brand_custom_css', wp_strip_all_tags( wp_unslash( $_POST['custom_css'] ) ) );
