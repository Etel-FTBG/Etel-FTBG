    /* ================================================================
     *  COMPANY ROLES -- who's admin/owner for each sibling project
     *  (that's who /service/company_admin resolves for payments/payouts)
     * ================================================================ */

    public static function company_roles_list() {
        self::guard();
        $filter_slug = isset( $_POST['company_slug'] ) ? sanitize_key( wp_unslash( $_POST['company_slug'] ) ) : '';
        $links = EtelID_DB::get_all_company_links( $filter_slug );
        $out = array();
        foreach ( $links as $l ) {
            $out[] = array(
                'id'           => (int) $l->id,
                'full_name'    => $l->full_name,
                'etel_id'      => $l->etel_id,
                'phone'        => $l->phone,
                'company_slug' => $l->company_slug,
                'role_at'      => $l->role_at,
                'linked_at'    => $l->linked_at,
            );
        }
        wp_send_json_success( array(
            'links'        => $out,
            'known_slugs'  => EtelID_DB::get_known_company_slugs(),
        ) );
    }

    public static function company_roles_set() {
        self::guard();
        $identifier = isset( $_POST['member_identifier'] ) ? sanitize_text_field( wp_unslash( $_POST['member_identifier'] ) ) : '';
        $slug       = isset( $_POST['company_slug'] )      ? sanitize_key( wp_unslash( $_POST['company_slug'] ) )            : '';
        $role       = isset( $_POST['role_at'] )            ? sanitize_text_field( wp_unslash( $_POST['role_at'] ) )          : '';

        if ( ! $identifier ) wp_send_json_error( array( 'message' => 'Enter a member Etel-ID or phone.' ) );
        if ( ! $slug )       wp_send_json_error( array( 'message' => 'Enter a company slug (e.g. delivery, gebeya, pay).' ) );
        if ( ! $role )       wp_send_json_error( array( 'message' => 'Choose a role.' ) );

        $member = EtelID_DB::get_by_etel_id( strtoupper( $identifier ) );
        if ( ! $member ) $member = EtelID_DB::find_by_phone( $identifier );
        if ( ! $member ) wp_send_json_error( array( 'message' => 'No member found for "' . $identifier . '".' ) );

        $canonical    = EtelID_Generator::companies();
        $company_name = isset( $canonical[ $slug ] ) ? $canonical[ $slug ]['name'] : ucfirst( $slug );

        EtelID_DB::set_company_role( $member->id, $slug, $company_name, $role );
        EtelID_DB::log( $member->id, $member->etel_id, 'company_role_set', "Set role '{$role}' for company '{$slug}' by admin" );

        wp_send_json_success( array( 'message' => $member->full_name . ' is now ' . $role . ' for ' . $company_name . ' (' . $slug . ').' ) );
    }

    public static function company_roles_remove() {
        self::guard();
        $id = isset( $_POST['id'] ) ? (int) $_POST['id'] : 0;
        if ( ! $id ) wp_send_json_error( array( 'message' => 'Missing link id.' ) );
        EtelID_DB::remove_company_link( $id );
        wp_send_json_success();
    }
