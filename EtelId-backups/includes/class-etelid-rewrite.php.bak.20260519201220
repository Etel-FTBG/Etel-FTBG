<?php
/**
 * Etel-ID Premium — URL Rewrite Rules v3.1.3
 *
 * Routes:
 *   /etel-id/apply/            → apply-form.php   (standalone)
 *   /etel-id/login/            → auth-page.php    (standalone)
 *   /etel-id/signup/           → auth-page.php    (standalone)
 *   /etel-id/portal/           → portal.php       (standalone)
 *   /etel-id/logout/           → logout + redirect
 *   /etel-id/verify/{ID}       → verify.php       (standalone)
 *   /etel-id/print/{ID}        → print-page.php   (standalone)
 *
 * Slug redirects — any WP page that uses these slugs gets redirected
 * to the proper Etel-ID standalone page:
 *   /EtelId/   /etelid/   /etel-id/   → /etel-id/apply/
 *   /etel-id/etelid/                  → /etel-id/apply/
 *
 * PHP 5.6+ compatible — no arrow functions.
 */
if ( ! defined( 'ABSPATH' ) ) exit;

class EtelID_Rewrite {

    public static function init() {
        add_action( 'init',              array( __CLASS__, 'add_rules' ) );
        add_filter( 'query_vars',        array( __CLASS__, 'query_vars' ) );
        add_action( 'template_redirect', array( __CLASS__, 'handle' ), 1 );
        /* Redirect WP page slugs → proper Etel-ID URLs */
        add_action( 'template_redirect', array( __CLASS__, 'redirect_wp_pages' ), 2 );
    }

    /* ── Rewrite rules ── */
    public static function add_rules() {
        add_rewrite_rule( '^etel-id/verify/([A-Z0-9\-]+)/?$', 'index.php?etelid_verify=$matches[1]', 'top' );
        add_rewrite_rule( '^etel-id/print/([A-Z0-9\-]+)/?$',  'index.php?etelid_print=$matches[1]',  'top' );
        add_rewrite_rule( '^etel-id/apply/?$',                 'index.php?etelid_page=apply',         'top' );
        add_rewrite_rule( '^etel-id/login/?$',                 'index.php?etelid_page=login',         'top' );
        add_rewrite_rule( '^etel-id/signup/?$',                'index.php?etelid_page=signup',        'top' );
        add_rewrite_rule( '^etel-id/portal/?$',                'index.php?etelid_page=portal',        'top' );
        add_rewrite_rule( '^etel-id/logout/?$',                'index.php?etelid_page=logout',        'top' );
        add_rewrite_rule( '^etel-id/profile/?$',               'index.php?etelid_page=profile',       'top' );
    }

    public static function query_vars( $vars ) {
        $vars[] = 'etelid_verify';
        $vars[] = 'etelid_print';
        $vars[] = 'etelid_page';
        return $vars;
    }

    /* ── Handle Etel-ID rewrite vars → serve standalone templates ── */
    public static function handle() {
        $verify = get_query_var( 'etelid_verify' );
        $print  = get_query_var( 'etelid_print' );
        $page   = get_query_var( 'etelid_page' );

        if ( $verify ) {
            include ETELID_PATH . 'templates/verify.php';
            exit;
        }

        if ( $print ) {
            $member = EtelID_DB::get_by_etel_id( $print );
            if ( $member ) {
                EtelID_DB::log( $member->id, $member->etel_id, 'printed', 'Print page' );
                include ETELID_PATH . 'templates/print-page.php';
            } else {
                wp_die( 'Etel-ID not found.' );
            }
            exit;
        }

        if ( $page === 'apply' ) {
            include ETELID_PATH . 'templates/apply-form.php';
            exit;
        }

        if ( $page === 'login' || $page === 'signup' ) {
            include ETELID_PATH . 'templates/auth-page.php';
            exit;
        }

        if ( $page === 'portal' ) {
            include ETELID_PATH . 'templates/portal.php';
            exit;
        }

        if ( $page === 'logout' ) {
            EtelID_Auth::logout();
            wp_redirect( home_url( '/etel-id/login/' ), 302 );
            exit;
        }
    }

    /* ── Redirect WP pages with Etel-ID-related slugs ── */
    public static function redirect_wp_pages() {
        if ( ! is_page() && ! is_singular() ) return;

        global $post;
        if ( ! $post ) return;

        /* IMPORTANT: Never intercept etel-id/* sub-paths.
         * Only match EXACT top-level WP page slugs.
         * Check REQUEST_URI to ensure we are not already on an etel-id/* path. */
        $uri = isset( $_SERVER['REQUEST_URI'] ) ? $_SERVER['REQUEST_URI'] : '';
        if ( preg_match( '#/etel-id/(profile|portal|login|signup|apply|logout|verify|print)#i', $uri ) ) {
            return; /* Already on a real Etel-ID route — do not redirect */
        }

        $slug = strtolower( $post->post_name );

        /* Map WP page slugs → Etel-ID URLs */
        $map = array(
            /* Apply form */
            'etelid'        => '/etel-id/apply/',
            'etel_id'       => '/etel-id/apply/',
            'apply-etelid'  => '/etel-id/apply/',
            'get-etelid'    => '/etel-id/apply/',
            'etelid-apply'  => '/etel-id/apply/',
            /* Login */
            'etelid-login'  => '/etel-id/login/',
            'etel-login'    => '/etel-id/login/',
            'member-login'  => '/etel-id/login/',
            /* Portal */
            'etelid-portal' => '/etel-id/portal/',
            'member-portal' => '/etel-id/portal/',
            'etel-portal'   => '/etel-id/portal/',
            /* Profile */
            'etelid-profile'=> '/etel-id/profile/',
            'edit-profile'  => '/etel-id/profile/',
        );

        if ( isset( $map[ $slug ] ) ) {
            wp_redirect( home_url( $map[ $slug ] ), 301 );
            exit;
        }

        /* Special: /EtelId/ exact slug → apply */
        if ( $slug === 'etelid' || ( isset( $_SERVER['REQUEST_URI'] ) && preg_match( '#^/EtelId/?$#', $_SERVER['REQUEST_URI'] ) ) ) {
            wp_redirect( home_url( '/etel-id/apply/' ), 301 );
            exit;
        }

        /* Also catch /etel-id/etelid/ double-path pattern */
        $uri = isset( $_SERVER['REQUEST_URI'] ) ? $_SERVER['REQUEST_URI'] : '';
        if ( preg_match( '#/etel-id/etelid/?#i', $uri ) ) {
            wp_redirect( home_url( '/etel-id/apply/' ), 301 );
            exit;
        }
    }
}
