<script>
var EtelIDConfig = { nonce: '<?php echo esc_js($nonce); ?>', ajax: '<?php echo esc_js($ajax); ?>' };
var _eidCurrent  = 1;
var _eidData     = {};

function etelIDNext(from) {
  if (!etelIDValidate(from)) return;
  etelIDCollect();
  etelIDGoto(from + 1);
  if (from + 1 === 4) etelIDRenderReview();
}
function etelIDBack(from) { etelIDGoto(from - 1); }
function etelIDGoto(n) {
  document.getElementById('eid-step-' + _eidCurrent).style.display = 'none';
  document.getElementById('eid-form-error').style.display = 'none';
  _eidCurrent = n;
  document.getElementById('eid-step-' + n).style.display = 'block';
  [1,2,3,4].forEach(function(i) {
    document.getElementById('step-dot-' + i).className =
      'eid-step-item' + (i < n ? ' done' : (i === n ? ' active' : ''));
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function etelIDValidate(step) {
  var ok = true;
  if (step === 1) {
    if (!document.getElementById('f-full_name').value.trim()) ok = false;
    if (!document.getElementById('f-dob').value)              ok = false;
    if (!document.getElementById('f-phone').value.trim())     ok = false;
  }
  if (!ok) {
    var err = document.getElementById('eid-form-error');
    document.getElementById('eid-error-text').textContent = 'Please fill in all required fields (marked with *).';
    err.style.display = 'flex';
    err.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  return ok;
}
function etelIDCollect() {
  var fields = ['full_name','full_name_am','dob','sex','blood_type','nationality',
    'phone','email','region','zone','woreda','primary_company_slug','role','department','employee_number'];
  fields.forEach(function(f) {
    var el = document.getElementById('f-' + f);
    if (el) _eidData[f] = el.value;
  });
  var extras = document.querySelectorAll('input[name="extra_companies[]"]:checked');
  _eidData.extra_companies = Array.from(extras).map(function(c){ return c.value; });
}
function etelIDRenderReview() {
  etelIDCollect();
  var d = _eidData;
  var rows = [
    ['Full Name', d.full_name], ['Amharic Name', d.full_name_am || '—'],
    ['Date of Birth', d.dob], ['Sex', d.sex], ['Blood Type', d.blood_type || '—'],
    ['Nationality', d.nationality], ['Phone', d.phone], ['Email', d.email || '—'],
    ['Region', d.region || '—'], ['Zone', d.zone || '—'], ['Woreda', d.woreda || '—'],
    ['Company', d.primary_company_slug], ['Role', d.role || '—'],
    ['Also linked to', (d.extra_companies && d.extra_companies.length ? d.extra_companies.join(', ') : '—')],
  ];
  var html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">';
  rows.forEach(function(r) {
    html += '<div style="background:rgba(212,175,55,.08);border:.5px solid rgba(212,175,55,.3);border-radius:6px;padding:10px 14px;">'
          + '<div style="font-family:\'JetBrains Mono\',monospace;font-size:8px;color:#A07020;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:3px;">' + r[0] + '</div>'
          + '<div style="font-size:14px;font-weight:600;color:#1A0E00;">' + (r[1] || '—') + '</div>'
          + '</div>';
  });
  html += '</div>';
  document.getElementById('eid-review-summary').innerHTML = html;
}
function etelIDSubmit() {
  etelIDCollect();
  var btn = document.getElementById('eid-submit-btn');
  var lbl = document.getElementById('eid-btn-label');
  btn.disabled = true;
  lbl.textContent = 'Issuing your ID…';
  var body = 'action=etelid_apply&nonce=' + EtelIDConfig.nonce;
  var d = _eidData;
  ['full_name','full_name_am','dob','sex','blood_type','nationality',
   'phone','email','region','zone','woreda','primary_company_slug','role','department','employee_number'].forEach(function(k) {
    if (d[k]) body += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(d[k]);
  });
  if (d.extra_companies) {
    d.extra_companies.forEach(function(v) { body += '&extra_companies[]=' + encodeURIComponent(v); });
  }
  fetch(EtelIDConfig.ajax, { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: body })
    .then(function(r){ return r.json(); })
    .then(function(res) {
      if (res.success) {
        document.getElementById('eid-step-4').style.display = 'none';
        document.getElementById('eid-success-state').style.display = 'block';
        document.getElementById('res-etel-id').textContent = res.data.etel_id;
        document.getElementById('res-fin').textContent     = res.data.fin;
        document.getElementById('res-verify-link').href    = res.data.verify_url;
        [1,2,3,4].forEach(function(i){ document.getElementById('step-dot-'+i).className = 'eid-step-item done'; });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        document.getElementById('eid-error-text').textContent = (res.data && res.data.message) ? res.data.message : 'Submission failed. Please try again.';
        document.getElementById('eid-form-error').style.display = 'flex';
        btn.disabled = false;
        lbl.textContent = 'Issue My Etel-ID';
      }
    })
    .catch(function() { btn.disabled = false; lbl.textContent = 'Issue My Etel-ID'; });
}
</script>

