<script>
var _EID = {
  ajax:  '<?php echo esc_js($ajax); ?>',
  nonce: '<?php echo esc_js($nonce); ?>',
  flipped: false
};

function flipCard() {
  _EID.flipped = !_EID.flipped;
  document.getElementById('card-3d').classList.toggle('flipped', _EID.flipped);
  document.getElementById('card-side-lbl').textContent = _EID.flipped ? 'BACK SIDE' : 'FRONT SIDE';
}

function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(function() {
    var orig = btn.innerHTML;
    btn.innerHTML = '<i class="ti ti-check"></i>';
    btn.style.color = '#86efac';
    setTimeout(function() { btn.innerHTML = orig; btn.style.color = ''; }, 1800);
  });
}

function doChangePw() {
  var old = document.getElementById('pw-old').value;
  var nw  = document.getElementById('pw-new').value;
  var cfm = document.getElementById('pw-cfm').value;
  var msg = document.getElementById('pw-msg');
  if (!old || !nw || !cfm) { showPwMsg('Please fill in all fields.', false); return; }
  if (nw.length < 6)        { showPwMsg('New password must be at least 6 characters.', false); return; }
  if (nw !== cfm)           { showPwMsg('New passwords do not match.', false); return; }
  var btn = document.querySelector('.pw-submit-btn');
  btn.disabled = true; btn.textContent = 'Updating…';
  fetch(_EID.ajax, {
    method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:'action=etelid_auth_change_password&nonce='+_EID.nonce+'&old_password='+encodeURIComponent(old)+'&new_password='+encodeURIComponent(nw)+'&confirm_password='+encodeURIComponent(cfm)
  }).then(function(r){return r.json();}).then(function(res) {
    if (res.success) {
      showPwMsg('✓ Password updated successfully!', true);
      document.getElementById('pw-old').value = '';
      document.getElementById('pw-new').value = '';
      document.getElementById('pw-cfm').value = '';
    } else {
      showPwMsg((res.data && res.data.message) ? res.data.message : 'Error. Please try again.', false);
    }
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-lock-check"></i> Update Password';
  });
}
function showPwMsg(text, ok) {
  var el = document.getElementById('pw-msg');
  el.textContent = text;
  el.className = 'pw-msg ' + (ok ? 'pw-msg-ok' : 'pw-msg-err');
  el.style.display = 'block';
  if (ok) setTimeout(function(){ el.style.display='none'; }, 4000);
}

function doSignOut() {
  fetch(_EID.ajax, {
    method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:'action=etelid_auth_logout&nonce='+_EID.nonce
  }).then(function(r){return r.json();}).then(function(res) {
    if (res.success && res.data.redirect) location.href = res.data.redirect;
    else location.href = '<?php echo esc_js(home_url("/etel-id/login/")); ?>';
  });
}

/* 3D tilt effect on card (desktop only) */
var scene = document.querySelector('.id-card-scene');
var card3d = document.getElementById('card-3d');
if (scene && card3d && window.matchMedia('(hover:hover)').matches) {
  scene.addEventListener('mousemove', function(e) {
    if (_EID.flipped) return;
    var rect = scene.getBoundingClientRect();
    var x = (e.clientX - rect.left) / rect.width  - 0.5;
    var y = (e.clientY - rect.top)  / rect.height - 0.5;
    card3d.style.transform =
      'perspective(1000px) rotateY(' + (x * 12) + 'deg) rotateX(' + (-y * 7) + 'deg) scale(1.02)';
  });
  scene.addEventListener('mouseleave', function() {
    if (_EID.flipped) return;
    card3d.style.transform = '';
    card3d.style.transition = 'transform .5s ease';
    setTimeout(function(){ card3d.style.transition = ''; }, 500);
  });
}
</script>
</body>
