 * already in scope (may be null if the token was invalid/revoked).
 */

if (!defined('ABSPATH')) {
    exit;
}

$has_member = !empty($member);
$name = $has_member ? esc_html($member->full_name) : '';
$etelid_number = $has_member ? esc_html($member->etelid_number) : '';
