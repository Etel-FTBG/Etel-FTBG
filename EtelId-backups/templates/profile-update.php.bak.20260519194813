<script>
var _PF = { ajax:'<?php echo esc_js($ajax); ?>', nonce:'<?php echo esc_js($nonce); ?>' };

/* Photo preview */
function updatePhotoPreview(url) {
  var p = document.getElementById('pf-photo-preview');
  if (url) {
    p.innerHTML = '<img src="'+url+'" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">';
  }
}
function handlePhotoFile(input) {
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    document.getElementById('pf-photo-url').value = e.target.result;
    updatePhotoPreview(e.target.result);
  };
  reader.readAsDataURL(file);
}

/* Form submit */
document.getElementById('pf-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('pf-submit-btn');
  var lbl = document.getElementById('pf-submit-lbl');
  var msg = document.getElementById('pf-msg');
  btn.disabled = true;
  lbl.textContent = 'Saving…';
  msg.style.display = 'none';

  var data = new FormData(this);
  var body = 'action=etelid_profile_update&nonce=' + _PF.nonce;
  data.forEach(function(v, k) {
    body += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(v);
  });

  fetch(_PF.ajax, {
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:body
  }).then(function(r){return r.json();}).then(function(res) {
    if (res.success) {
      msg.className = 'pf-msg pf-msg-ok';
      msg.textContent = '✓ ' + (res.data.message || 'Profile updated successfully!');
      msg.style.display = 'block';
      /* Update avatar if photo changed */
      var photoUrl = document.querySelector('[name=photo_url]').value;
      if (photoUrl) updatePhotoPreview(photoUrl);
      /* Update name display */
      var name = document.querySelector('[name=full_name]').value;
      var nameEl = document.querySelector('.pf-member-info-name');
      if (nameEl) nameEl.textContent = name;
    } else {
      msg.className = 'pf-msg pf-msg-err';
      msg.textContent = '✗ ' + (res.data && res.data.message ? res.data.message : 'Update failed. Please try again.');
      msg.style.display = 'block';
    }
    btn.disabled = false;
    lbl.textContent = 'Save Profile';
    msg.scrollIntoView({behavior:'smooth',block:'center'});
  }).catch(function() {
    btn.disabled = false;
    lbl.textContent = 'Save Profile';
    msg.className = 'pf-msg pf-msg-err';
    msg.textContent = '✗ Network error. Please try again.';
    msg.style.display = 'block';
  });
});
</script>
</body>
</html>
