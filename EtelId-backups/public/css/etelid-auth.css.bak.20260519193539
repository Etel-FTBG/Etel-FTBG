/**
 * Etel-ID Premium — Auth & Portal CSS (4K Gold Theme) v3.1.1
 */
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;500;600&family=Cormorant+Garamond:wght@400;600;700&family=Noto+Sans+Ethiopic:wght@400;600;700&display=swap');

:root {
  /* 4K Gold palette */
  --g1:#FDF6D8; --g2:#F5E6A3; --g3:#E8C84A; --g4:#D4AF37;
  --g5:#C8922A; --g6:#A07020; --g7:#7A5518; --g8:#4A3210;
  /* Page background — warm rich gold */
  --page-bg:     #B8860B;
  --page-bg2:    #A07020;
  --page-bg3:    #C8922A;
  /* Card background — warm cream white */
  --card-bg:     #FFFEF8;
  --card-bg2:    #FDF8EE;
  --card-bg3:    #F5EDD5;
  /* Text on gold bg */
  --text-on-gold:#1A0E00;
  --text-2:      #3A2200;
  --text-3:      #6A4A10;
  /* Text on white card */
  --ink:         #1A0E00;
  --ink2:        #3A2200;
  --ink3:        #7A5520;
  /* Borders */
  --border:      rgba(100,60,0,.25);
  --border-lt:   rgba(212,175,55,.5);
  /* Status */
  --ok:  #166534;  --ok-bg:  #dcfce7;
  --err: #991b1b;  --err-bg: #fee2e2;
}

/* ═══════════════════════════════════════════
   PAGE BACKGROUND — Pure 4K Gold
═══════════════════════════════════════════ */
@keyframes holo      { 0%{background-position:0 0} 100%{background-position:300% 0} }
@keyframes slide-up  { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
@keyframes pulse-ring{ 0%,100%{opacity:.2;transform:scale(1)} 50%{opacity:.06;transform:scale(1.1)} }
@keyframes float-orb { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-16px)} }
@keyframes shimmer   { 0%{background-position:-400px 0} 100%{background-position:400px 0} }
@keyframes spin-slow { from{transform:rotate(0)} to{transform:rotate(360deg)} }
@keyframes check-pop { 0%{transform:scale(0) rotate(-12deg);opacity:0} 70%{transform:scale(1.15) rotate(2deg)} 100%{transform:scale(1) rotate(0);opacity:1} }

.eid-auth-page {
  min-height: 100vh;
  /* Rich 4K gold radial gradient background */
  background:
    radial-gradient(ellipse at 20% 20%, rgba(255,220,80,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 80%, rgba(120,70,0,.3) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(200,146,42,.15) 0%, transparent 70%),
    linear-gradient(135deg, #6B4A00 0%, #9A6A10 15%, #C8922A 30%, #D4AF37 45%, #E8C84A 55%, #D4AF37 65%, #C8922A 78%, #8A5A08 90%, #5A3A00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  position: relative;
  overflow: hidden;
  font-family: 'Cormorant Garamond', serif;
}

/* Guilloché security pattern over gold */
.eid-auth-page::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(30deg,  transparent 0, transparent 18px, rgba(255,255,255,.04) 18px, rgba(255,255,255,.04) 19px),
    repeating-linear-gradient(-30deg, transparent 0, transparent 18px, rgba(255,255,255,.04) 18px, rgba(255,255,255,.04) 19px),
    repeating-linear-gradient(90deg,  transparent 0, transparent 36px, rgba(0,0,0,.03) 36px, rgba(0,0,0,.03) 37px);
}
/* Floating light orbs */
.eid-auth-page::after {
  content: '';
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,230,100,.18) 0%, transparent 65%);
  top: -200px; left: -200px;
  animation: float-orb 8s ease-in-out infinite;
  pointer-events: none;
}
/* Grid lines (subtle, gold-on-gold) */
.eid-auth-grid {
  position: absolute; inset: 0; pointer-events: none; opacity: .04;
  background-image:
    linear-gradient(rgba(255,255,255,1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px);
  background-size: 52px 52px;
}

/* ═══════════════════════════════════════════
   AUTH CARD — Cream white on gold bg
═══════════════════════════════════════════ */
.eid-auth-card {
  width: 100%;
  max-width: 460px;
  background: var(--card-bg);
  border: 1.5px solid rgba(212,175,55,.6);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  z-index: 10;
  animation: slide-up .55s cubic-bezier(.22,.68,0,1.2) both;
  box-shadow:
    0 0 0 1px rgba(255,220,80,.3),
    0 4px 0 0 rgba(100,60,0,.5),
    0 8px 32px rgba(80,40,0,.4),
    0 32px 80px rgba(60,30,0,.3),
    inset 0 1px 0 rgba(255,255,255,.9);
}

/* Holographic rainbow top strip */
.eid-auth-holo {
  height: 3px;
  background: linear-gradient(90deg,
    #D4AF37,#F5E6A3,#E8C84A,#C8922A,#F5D878,#D4AF37,
    #E8C84A,#F5E6A3,#C8922A,#D4AF37,#F5D878,#E8C84A);
  background-size: 300% 100%;
  animation: holo 3s linear infinite;
}

/* Card header */
.eid-auth-head {
  padding: 28px 32px 16px;
  text-align: center;
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg2) 100%);
  border-bottom: 1.5px solid rgba(212,175,55,.35);
}
.eid-auth-logo {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
/* Logo image replaces ኢE text */
.eid-auth-logo-img {
  height: 52px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(100,60,0,.3));
}
.eid-auth-sig {
  font-family: 'Syne', sans-serif;
  font-size: 42px;
  font-weight: 800;
  color: var(--g5);
  line-height: 1;
  text-shadow: 0 2px 12px rgba(200,146,42,.3);
}
.eid-auth-sig::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 2px solid rgba(212,175,55,.2);
  animation: spin-slow 8s linear infinite;
}
.eid-auth-org {
  font-family: 'Noto Sans Ethiopic', sans-serif;
  font-size: 11px;
  color: var(--g6);
  letter-spacing: 1px;
}
.eid-auth-title {
  font-family: 'Syne', sans-serif;
  font-size: 22px;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 4px;
}
.eid-auth-subtitle {
  font-size: 13px;
  color: var(--ink3);
}

/* ── Tabs ── */
.eid-auth-tabs {
  display: flex;
  border-bottom: 2px solid rgba(212,175,55,.3);
  background: var(--card-bg2);
}
.eid-auth-tab {
  flex: 1;
  padding: 12px;
  background: none;
  border: none;
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  color: var(--ink3);
  cursor: pointer;
  letter-spacing: .5px;
  transition: all .2s;
  border-bottom: 2.5px solid transparent;
  margin-bottom: -2px;
}
.eid-auth-tab.active {
  color: var(--g5);
  border-bottom-color: var(--g4);
  background: var(--card-bg);
}
.eid-auth-tab:hover { color: var(--g5); }

/* ── Auth body ── */
.eid-auth-body {
  padding: 20px 28px 24px;
  background: var(--card-bg);
}

/* ── Notices ── */
.eid-auth-notice {
  display: none;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 14px;
  font-family: 'Cormorant Garamond', serif;
}
.eid-auth-notice.show { display: flex; }
.eid-auth-notice-err  { background: var(--err-bg); border: 1px solid rgba(153,27,27,.3); color: var(--err); }
.eid-auth-notice-ok   { background: var(--ok-bg);  border: 1px solid rgba(22,101,52,.3);  color: var(--ok); }

/* ── Form fields ── */
.eid-af-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.eid-af-row-1 { margin-bottom: 14px; }
.eid-af-field { display: flex; flex-direction: column; gap: 5px; }
.eid-af-label {
  font-size: 12px;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: .5px;
  font-family: 'Syne', sans-serif;
  display: flex;
  align-items: center;
  gap: 5px;
}
.eid-af-label .req { color: var(--g5); }
.eid-af-input-wrap { position: relative; display: flex; align-items: center; }
.eid-af-input-icon {
  position: absolute;
  left: 12px;
  color: var(--g5);
  font-size: 15px;
  pointer-events: none;
}
.eid-af-input {
  width: 100%;
  padding: 10px 12px 10px 36px;
  background: var(--card-bg2);
  border: 1.5px solid rgba(212,175,55,.4);
  border-radius: 8px;
  font-size: 14px;
  font-family: 'Cormorant Garamond', serif;
  color: var(--ink);
  transition: border-color .2s, box-shadow .2s;
  box-shadow: inset 0 1px 3px rgba(100,60,0,.06);
}
.eid-af-input.no-icon { padding-left: 12px; }
.eid-af-input:focus {
  border-color: var(--g4);
  outline: none;
  box-shadow: 0 0 0 3px rgba(212,175,55,.18), inset 0 1px 3px rgba(100,60,0,.06);
  background: #FFFEF8;
}
.eid-af-input.has-error { border-color: #dc2626; }
.eid-af-select {
  width: 100%;
  padding: 10px 12px;
  background: var(--card-bg2);
  border: 1.5px solid rgba(212,175,55,.4);
  border-radius: 8px;
  font-size: 14px;
  font-family: 'Cormorant Garamond', serif;
  color: var(--ink);
  cursor: pointer;
}
.eid-af-select:focus { border-color: var(--g4); outline: none; }
.eid-af-err {
  font-size: 11px;
  color: #dc2626;
  display: none;
  font-family: 'JetBrains Mono', monospace;
}
.eid-af-err.show { display: block; }
.eid-pw-toggle {
  position: absolute;
  right: 10px;
  background: none;
  border: none;
  color: var(--g5);
  cursor: pointer;
  padding: 4px;
  font-size: 16px;
}

/* ── Submit button ── */
.eid-auth-submit {
  width: 100%;
  padding: 14px;
  background: linear-gradient(135deg, var(--g8) 0%, var(--g7) 15%, var(--g6) 30%, var(--g5) 45%, var(--g4) 55%, var(--g5) 65%, var(--g6) 78%, var(--g8) 100%);
  color: var(--g1);
  border: none;
  border-radius: 10px;
  font-family: 'Syne', sans-serif;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 6px;
  transition: all .2s;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 0 var(--g8), 0 6px 16px rgba(100,60,0,.35);
}
.eid-auth-submit::before {
  content: '';
  position: absolute;
  top: 0; left: -100%; width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
  animation: shimmer 2.5s infinite;
}
.eid-auth-submit:hover { transform: translateY(-1px); box-shadow: 0 5px 0 var(--g8), 0 8px 20px rgba(100,60,0,.4); }
.eid-auth-submit:active { transform: translateY(1px); box-shadow: 0 2px 0 var(--g8); }
.eid-auth-submit:disabled { opacity: .7; cursor: not-allowed; transform: none; }

/* ── Divider ── */
.eid-auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0;
  color: var(--ink3);
  font-size: 12px;
  font-family: 'JetBrains Mono', monospace;
}
.eid-auth-divider::before, .eid-auth-divider::after {
  content: ''; flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,175,55,.4), transparent);
}

/* ── Registration steps ── */
.eid-reg-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 20px;
}
.eid-reg-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: rgba(212,175,55,.25);
  border: 1.5px solid rgba(212,175,55,.3);
  transition: all .3s;
}
.eid-reg-dot.active { background: var(--g4); border-color: var(--g4); transform: scale(1.2); }
.eid-reg-dot.done   { background: var(--g6); border-color: var(--g6); }

.eid-step-nav { display: flex; gap: 10px; margin-top: 18px; }
.eid-step-next {
  flex: 1;
  padding: 12px;
  background: linear-gradient(135deg, var(--g7), var(--g5), var(--g4));
  color: var(--g1);
  border: none;
  border-radius: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-shadow: 0 3px 0 var(--g8);
  transition: all .15s;
}
.eid-step-next:hover { transform: translateY(-1px); }
.eid-step-back {
  width: 42px;
  background: var(--card-bg2);
  border: 1.5px solid rgba(212,175,55,.4);
  border-radius: 8px;
  color: var(--g5);
  cursor: pointer;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .15s;
}
.eid-step-back:hover { background: var(--card-bg3); border-color: var(--g4); }

/* Card footer */
.eid-auth-card > div:last-child {
  border-top: 1px solid rgba(212,175,55,.25) !important;
}

/* ═══════════════════════════════════════════
   PORTAL PAGE
═══════════════════════════════════════════ */
.eid-portal-page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 10% 10%, rgba(255,220,80,.3) 0%, transparent 45%),
    radial-gradient(ellipse at 90% 90%, rgba(100,50,0,.25) 0%, transparent 45%),
    linear-gradient(135deg, #6B4A00 0%, #9A6A10 20%, #C8922A 40%, #D4AF37 50%, #C8922A 60%, #9A6A10 80%, #5A3A00 100%);
  font-family: 'Cormorant Garamond', serif;
  color: var(--ink);
  padding-bottom: 60px;
  position: relative;
}
/* Pattern overlay */
.eid-portal-page::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(45deg, transparent 0, transparent 20px, rgba(255,255,255,.03) 20px, rgba(255,255,255,.03) 21px);
}
/* ── Portal hero ── */
.eid-portal-hero {
  background: linear-gradient(135deg, var(--g8) 0%, var(--g7) 30%, var(--g8) 100%);
  padding: 28px 32px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  border-bottom: 2px solid var(--g4);
  box-shadow: 0 4px 20px rgba(60,30,0,.4);
  position: relative;
  z-index: 1;
}
.eid-portal-hero::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--g3), var(--g1), var(--g3), transparent);
  background-size: 200% 100%;
  animation: holo 3s linear infinite;
}
.eid-portal-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.eid-portal-logo {
  height: 44px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,.4)) brightness(1.1);
}
.eid-portal-brand-text h1 {
  font-family: 'Syne', sans-serif;
  font-size: 20px;
  font-weight: 800;
  color: var(--g1);
  margin: 0 0 2px;
}
.eid-portal-brand-text p {
  font-family: 'Noto Sans Ethiopic', sans-serif;
  font-size: 11px;
  color: var(--g3);
  margin: 0;
}
.eid-portal-member-pill {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(212,175,55,.4);
  border-radius: 30px;
  padding: 8px 16px 8px 8px;
  backdrop-filter: blur(4px);
}
.eid-portal-avatar {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 2px solid var(--g4);
  object-fit: cover;
  background: var(--g6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 800;
  color: var(--g1);
  overflow: hidden;
  flex-shrink: 0;
}
.eid-portal-member-name {
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  color: var(--g1);
}
.eid-portal-member-id {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--g3);
}

/* ── Portal content wrapper ── */
.eid-portal-content {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px 20px 0;
  position: relative;
  z-index: 1;
}

/* ── Portal cards (white on gold bg) ── */
.eid-portal-card {
  background: var(--card-bg);
  border: 1.5px solid rgba(212,175,55,.45);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow:
    0 2px 0 rgba(100,60,0,.3),
    0 8px 24px rgba(60,30,0,.2),
    inset 0 1px 0 rgba(255,255,255,.9);
}
.eid-portal-card-head {
  padding: 14px 20px;
  background: linear-gradient(135deg, var(--g8) 0%, var(--g7) 50%, var(--g8) 100%);
  border-bottom: 1px solid var(--g5);
  display: flex;
  align-items: center;
  gap: 10px;
}
.eid-portal-card-head h3 {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 800;
  color: var(--g2);
  margin: 0;
  letter-spacing: .5px;
}
.eid-portal-card-head .ti {
  color: var(--g3);
  font-size: 18px;
}
.eid-portal-card-body {
  padding: 18px 20px;
  background: var(--card-bg);
}

/* ── ID preview card container ── */
.eid-portal-id-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 16px 0;
}
.eid-portal-id-scene {
  perspective: 1200px;
  cursor: pointer;
}
.eid-portal-id-scene .eid-card-wrap {
  width: 460px;
  height: 290px;
  transform-style: preserve-3d;
  transition: transform .7s cubic-bezier(.4,.2,.2,1);
}
.eid-portal-id-scene .eid-card-wrap.flipped { transform: rotateY(180deg); }
.eid-portal-id-scene .eid-face {
  position: absolute; inset: 0;
  border-radius: 10px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}
.eid-portal-id-scene .eid-back { transform: rotateY(180deg); }

/* Field rows in portal */
.eid-pf-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media(max-width:520px){ .eid-pf-grid{ grid-template-columns:1fr; } }
.eid-pf-item { display: flex; flex-direction: column; gap: 2px; }
.eid-pf-label {
  font-size: 10px;
  font-family: 'JetBrains Mono', monospace;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--g5);
}
.eid-pf-val {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
}
.eid-pf-val-am {
  font-family: 'Noto Sans Ethiopic', sans-serif;
  font-size: 13px;
  color: var(--ink2);
}
.eid-pf-val-mono {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--ink);
  letter-spacing: 1px;
}
/* Status pill */
.eid-status-pill {
  display: inline-block;
  padding: 3px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-family: 'JetBrains Mono', monospace;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
}
.eid-status-active    { background: #dcfce7; color: #166534; border: 1px solid rgba(22,101,52,.3); }
.eid-status-suspended { background: #fee2e2; color: #991b1b; border: 1px solid rgba(153,27,27,.3); }
.eid-status-pending   { background: #fef9c3; color: #854d0e; border: 1px solid rgba(133,77,14,.3); }

/* Action buttons */
.eid-portal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 4px;
}
.eid-btn-gold {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 18px;
  background: linear-gradient(135deg, var(--g8), var(--g6), var(--g5), var(--g4));
  color: var(--g1);
  border: none;
  border-radius: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
  box-shadow: 0 3px 0 var(--g8), 0 4px 12px rgba(100,60,0,.25);
  transition: all .15s;
}
.eid-btn-gold:hover { transform: translateY(-1px); color: var(--g1); text-decoration: none; }
.eid-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 18px;
  background: var(--card-bg2);
  color: var(--g5);
  border: 1.5px solid rgba(212,175,55,.5);
  border-radius: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
  transition: all .15s;
}
.eid-btn-outline:hover { background: var(--card-bg3); border-color: var(--g4); color: var(--g5); text-decoration: none; }

/* Log table */
.eid-log-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.eid-log-table th {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--g6);
  padding: 6px 10px;
  text-align: left;
  border-bottom: 1.5px solid rgba(212,175,55,.3);
  background: var(--card-bg2);
}
.eid-log-table td {
  padding: 8px 10px;
  border-bottom: 1px solid rgba(212,175,55,.12);
  color: var(--ink2);
  vertical-align: middle;
}
.eid-log-table tr:last-child td { border-bottom: none; }
.eid-log-table tr:hover td { background: rgba(212,175,55,.05); }
.eid-log-action {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-family: 'JetBrains Mono', monospace;
  background: rgba(212,175,55,.12);
  color: var(--g6);
  border: 1px solid rgba(212,175,55,.25);
}

/* Change password form */
.eid-pw-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 360px;
}
.eid-pw-form input {
  width: 100%;
  padding: 10px 12px;
  background: var(--card-bg2);
  border: 1.5px solid rgba(212,175,55,.4);
  border-radius: 8px;
  font-size: 14px;
  font-family: 'Cormorant Garamond', serif;
  color: var(--ink);
}
.eid-pw-form input:focus { border-color: var(--g4); outline: none; }

/* Logout link */
.eid-logout-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: rgba(220,38,38,.08);
  color: #dc2626;
  border: 1px solid rgba(220,38,38,.25);
  border-radius: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
  transition: all .15s;
}
.eid-logout-link:hover { background: rgba(220,38,38,.15); color: #dc2626; text-decoration: none; }

/* ── Verify page ── */
.eid-verify-wrap {
  max-width: 600px;
  margin: 0 auto;
  padding: 32px 20px;
  position: relative;
  z-index: 1;
}
.eid-verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  border-radius: 24px;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 20px;
}
.eid-verify-valid   { background: #dcfce7; border: 1.5px solid #16a34a; color: #15803d; }
.eid-verify-suspended{ background: #fef9c3; border: 1.5px solid #ca8a04; color: #92400e; }
.eid-verify-invalid { background: #fee2e2; border: 1.5px solid #dc2626; color: #991b1b; }

/* Responsive */
@media(max-width:500px){
  .eid-auth-body { padding: 16px 18px 20px; }
  .eid-af-row { grid-template-columns: 1fr; }
  .eid-portal-id-scene .eid-card-wrap { width: 320px; height: 202px; }
}

/* ═══════════════════════════════════════════
   PORTAL NAV BAR (gold theme)
═══════════════════════════════════════════ */
.eid-portal-nav {
  background: linear-gradient(135deg, var(--g8) 0%, var(--g7) 30%, var(--g8) 100%);
  padding: 14px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid var(--g4);
  box-shadow: 0 4px 16px rgba(40,20,0,.4);
  position: sticky;
  top: 0;
  z-index: 100;
}
.eid-portal-nav::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--g3), var(--g1), var(--g3), transparent);
  background-size: 300% 100%;
  animation: holo 3s linear infinite;
}
.eid-portal-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}
.eid-portal-logo {
  height: 38px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 2px 6px rgba(0,0,0,.5)) brightness(1.1);
}
.eid-portal-sig {
  font-family: 'Syne', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: var(--g3);
  line-height: 1;
}
.eid-portal-name {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 800;
  color: var(--g1);
  letter-spacing: .3px;
}
.eid-portal-greeting {
  font-size: 11px;
  color: var(--g3);
  font-family: 'Cormorant Garamond', serif;
}
.eid-portal-logout {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: rgba(220,38,38,.15);
  color: #fca5a5;
  border: 1px solid rgba(220,38,38,.3);
  border-radius: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: all .15s;
}
.eid-portal-logout:hover { background: rgba(220,38,38,.25); color: #fecaca; }

/* Portal content */
.eid-portal-content {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px 20px;
  position: relative;
  z-index: 1;
}

/* Action buttons in portal */
.eid-portal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}
.eid-portal-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 20px;
  border-radius: 9px;
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  text-decoration: none;
  transition: all .15s;
  border: none;
}
.eid-pab-gold {
  background: linear-gradient(135deg, var(--g8), var(--g6), var(--g5), var(--g4));
  color: var(--g1);
  box-shadow: 0 3px 0 var(--g8), 0 5px 14px rgba(100,60,0,.25);
}
.eid-pab-gold:hover { transform: translateY(-1px); color: var(--g1); text-decoration: none; }
.eid-pab-outline {
  background: var(--card-bg);
  color: var(--g5);
  border: 1.5px solid rgba(212,175,55,.5);
  box-shadow: 0 2px 8px rgba(60,30,0,.12);
}
.eid-pab-outline:hover { background: var(--card-bg2); border-color: var(--g4); color: var(--g5); text-decoration: none; }

/* Portal section cards */
.eid-portal-section {
  background: var(--card-bg);
  border: 1.5px solid rgba(212,175,55,.4);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow:
    0 2px 0 rgba(100,60,0,.25),
    0 8px 24px rgba(60,30,0,.15),
    inset 0 1px 0 rgba(255,255,255,.9);
}
.eid-portal-section-head {
  padding: 13px 20px;
  background: linear-gradient(135deg, var(--g8) 0%, var(--g7) 50%, var(--g8) 100%);
  border-bottom: 1px solid var(--g5);
  display: flex;
  align-items: center;
  gap: 9px;
}
.eid-portal-section-head h3 {
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 800;
  color: var(--g2);
  margin: 0;
  letter-spacing: .5px;
}
.eid-portal-section-head .ti { color: var(--g3); font-size: 17px; }
.eid-portal-section-body { padding: 18px 20px; }

/* Member ID card display in portal */
.eid-id-display-wrap {
  display: flex;
  justify-content: center;
  padding: 8px 0;
  overflow-x: auto;
}
