/**
 * Etel-ID Premium — Print Page CSS v3.1.0
 */
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@400;600&family=Noto+Sans:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap');

/* ── Screen: dark wrapper ── */
.eid-print-page-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 20px 48px;
  background: linear-gradient(135deg, #5A3A00 0%, #8A5A10 15%, #C8922A 35%, #D4AF37 50%, #C8922A 65%, #8A5A10 85%, #5A3A00 100%);
  min-height: 100vh;
  font-family: 'Noto Sans', sans-serif;
}

/* ── Controls bar ── */
.eid-print-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 28px;
}
.eid-print-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 22px;
  border-radius: 8px;
  font-family: 'Noto Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: all .2s;
  line-height: 1;
}
.eid-print-btn-gold {
  background: linear-gradient(135deg, #c8922a, #7a5518);
  color: #fff;
  box-shadow: 0 2px 12px rgba(200,146,42,.3);
}
.eid-print-btn-gold:hover { opacity: .88; color: #fff; }
.eid-print-btn-ghost {
  background: rgba(255,255,255,.08);
  color: var(--g9, #2A1A06);
  border: 1px solid rgba(200,146,42,.3);
}
.eid-print-btn-ghost:hover { background: rgba(255,255,255,.13); color: #e8c48a; }

/* ── A4 paper sheet ── */
.eid-print-sheet {
  width: 210mm;
  background: #f0f0f0;
  box-shadow: 0 8px 48px rgba(0,0,0,.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20mm 0;
  gap: 0;
  position: relative;
}
.eid-print-sheet-label {
  position: absolute;
  top: 6px; left: 12px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 8px;
  color: #aaa;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ── Card slot ── */
.eid-card-slot {
  position: relative;
  width: 89.6mm;
  height: 57.98mm;
  margin: 8mm auto;
  flex-shrink: 0;
}
/* Bleed zone */
.eid-bleed-box {
  position: absolute;
  inset: 0;
  background: rgba(200,180,180,.08);
  border: .5px dashed rgba(200,100,100,.18);
  pointer-events: none;
}
/* Trim box */
.eid-trim-box {
  position: absolute;
  top: 2mm; left: 2mm;
  width: 85.6mm;
  height: 53.98mm;
  border-radius: 3.18mm;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,.25);
}
/* Crop marks */
.eid-crop-mark { position: absolute; background: #555; }
.eid-cm-tl-h { top: 2mm; left: -5mm; width: 4mm; height: .3px; }
.eid-cm-tl-v { top: -5mm; left: 2mm; width: .3px; height: 4mm; }
.eid-cm-tr-h { top: 2mm; right: -5mm; width: 4mm; height: .3px; }
.eid-cm-tr-v { top: -5mm; right: 2mm; width: .3px; height: 4mm; }
.eid-cm-bl-h { bottom: 2mm; left: -5mm; width: 4mm; height: .3px; }
.eid-cm-bl-v { bottom: -5mm; left: 2mm; width: .3px; height: 4mm; }
.eid-cm-br-h { bottom: 2mm; right: -5mm; width: 4mm; height: .3px; }
.eid-cm-br-v { bottom: -5mm; right: 2mm; width: .3px; height: 4mm; }

/* Spec + side labels */
.eid-print-spec {
  position: absolute;
  right: -44mm; top: 50%;
  transform: translateY(-50%);
  font-family: 'JetBrains Mono', monospace;
  font-size: 6.5px;
  color: #888;
  line-height: 1.8;
  white-space: nowrap;
  border-left: .5px solid #ccc;
  padding-left: 6px;
}
.eid-slot-label {
  position: absolute;
  left: -22mm; top: 50%;
  transform: translateY(-50%) rotate(-90deg);
  font-family: 'JetBrains Mono', monospace;
  font-size: 7px;
  color: #bbb;
  letter-spacing: 2px;
  text-transform: uppercase;
  white-space: nowrap;
}
/* Card face inside trim */
.eid-trim-box .eid-card-front,
.eid-trim-box .eid-card-back {
  position: absolute;
  inset: 0;
  border-radius: 3.18mm;
}

/* Print tip */
.eid-print-tip {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--g9, #2A1A06);
  letter-spacing: .8px;
  text-align: center;
  margin-top: 16px;
}

/* ═══════════════════════════════════════════
   @MEDIA PRINT
═══════════════════════════════════════════ */
@media print {
  body > * { display: none !important; }
  .eid-print-page-wrap,
  .eid-print-page-wrap * { display: revert !important; visibility: visible !important; }
  .eid-print-controls,
  .eid-print-tip,
  .eid-print-sheet-label,
  .eid-print-spec,
  .eid-slot-label,
  .eid-bleed-box,
  .no-print { display: none !important; }

  @page { size: A4 portrait; margin: 0; }

  .eid-print-page-wrap {
    background: #fff !important;
    padding: 0 !important;
    min-height: 0 !important;
    display: block !important;
  }
  .eid-print-sheet {
    width: 210mm !important;
    min-height: 297mm !important;
    background: #fff !important;
    box-shadow: none !important;
    padding: 18mm 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }
  .eid-card-slot {
    width: 89.6mm !important;
    height: 57.98mm !important;
    margin: 10mm auto !important;
  }
  .eid-trim-box {
    top: 2mm !important; left: 2mm !important;
    width: 85.6mm !important; height: 53.98mm !important;
    border-radius: 3.18mm !important;
    box-shadow: none !important;
  }
  .eid-crop-mark { background: #000 !important; }
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
  .nid-front, .nid-back {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}

/* ── New card classes inside trim box ── */
.eid-trim-box .eid-card-front,
.eid-trim-box .eid-card-back {
  position: absolute !important;
  top: 0 !important; left: 0 !important;
  right: 0 !important; bottom: 0 !important;
  border-radius: 3.18mm !important;
  -webkit-print-color-adjust: exact !important;
  print-color-adjust: exact !important;
}

/* Ensure all absolute-positioned elements inside card render in PDF */
@media print {
  .eid-card-front *, .eid-card-back * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .efc-header, .efc-footer,
  .ecb-header, .ecb-footer, .ecb-dates {
    display: block !important;
  }
}
