# ETEL AI — EtelAi folder rules
# The real updater password must be set directly in the live server's
# .htaccess (or cPanel's PHP env var UI), never committed here - a
# previous commit had the actual live password on this line in plain
# text, publicly readable in this repo's git history. Rotate that
# password on the server; do not reuse it.
#SetEnv ETEL_UPDATER_PASS CHANGE_ME
# Allow JSON, JS, and web app files
<FilesMatch "\.(json|js|webmanifest|txt)$">
    Require all granted
</FilesMatch>

# Specifically allow manifest and version files
<Files "manifest.json">
    Require all granted
</Files>
<Files "version.json">
    Require all granted
</Files>

# Correct MIME types
AddType application/json .json
AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType image/png .png

# Service worker scope
<Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
</Files>

# No caching for HTML and JS (always get latest)
<FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Enable CORS
Header always set Access-Control-Allow-Origin "*"

# Allow microphone (needed for ETEL AI's voice input) - something outside
# this .htaccess (WAF/server-level, not caching - this folder already
# disables caching entirely above) has been forcing microphone=() on
# every response site-wide. Testing whether an explicit override here
# can win for this specific folder.
Header always set Permissions-Policy "microphone=(self)"

Options -Indexes
