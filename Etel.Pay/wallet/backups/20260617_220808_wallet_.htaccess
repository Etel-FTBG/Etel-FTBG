# ── ኢE Pay Wallet — LiteSpeed v4 ────────────────────────────
Options -Indexes
DirectoryIndex login index

# ── Clean URLs (no .html extension) ──────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the exact file exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /wallet → login.html (root of wallet folder)
  RewriteRule ^$ login.html [L]

  # Clean URLs: /wallet/dashboard → wallet.html, /wallet/send → send.html etc
  RewriteRule ^login$    login.html    [L]
  RewriteRule ^wallet$   wallet.html   [L]
  RewriteRule ^send$     send.html     [L]
  RewriteRule ^history$  history.html  [L]
  RewriteRule ^qr$       qr.html       [L]
  RewriteRule ^profile$  profile.html  [L]
  RewriteRule ^admin$    admin.html    [L]
  RewriteRule ^register$ register.html [L]
  RewriteRule ^updater$    updater.html   [L]
  RewriteRule ^topup$      topup.html     [L]
  RewriteRule ^pay-links$  pay-links.html [L]
  RewriteRule ^analytics$  analytics.html [L]
  RewriteRule ^kyc$        kyc.html       [L]
  RewriteRule ^pay$        pay.html       [L]
  RewriteRule ^pay/(.+)$   pay.html       [L]

  # Favicon
  RewriteRule ^favicon\.ico$ icons/icon-96.png [L,R=301]
</IfModule>

# ── MIME types ────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/json    .json
  AddType text/javascript     .js
  AddType image/x-icon        .ico
</IfModule>

# ── Gzip ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Cache ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType application/json       "access plus 0 seconds"
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>

  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stop MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # XSS filter for older browsers
  Header always set X-XSS-Protection "1; mode=block"

  # HTTPS enforcement — 1 year, includes subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Referrer policy — don't leak wallet URLs to third parties
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions — camera allowed for QR scanner, payment for wallet
  Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=(), payment=(self)"

  # Content Security Policy
  # unsafe-inline required for Three.js coin animation and inline wallet styles.
  # connect-src locked to same origin only — all API calls are self-hosted.
  # No Google Maps, no FCM — Pay is a pure wallet, not a map/delivery app.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://ethelmarket.com; connect-src 'self' https://ethelmarket.com https://www.ethelmarket.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none';"

  # Allow Service Worker scope for PWA
  Header always set Service-Worker-Allowed "/"

  # Remove server fingerprints
  Header always unset Server
  Header always unset X-Powered-By

</IfModule>

# ── Force HTTPS ───────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?ethelmarket\.com$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Block .env ────────────────────────────────────────────────
<Files ".env">
  Order Allow,Deny
  Deny from all
</Files>
