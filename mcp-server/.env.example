# Copy this file to .env and fill in real values. Never commit .env.
# Shared secret this MCP server requires from every caller. Send it as ONE of:
#   Authorization: Bearer <key>   |   X-API-Key: <key>   |   X-Mcp-Key: <key>   |   ?key=<key> (last resort)
MCP_SHARED_KEY=CHANGE_ME

# Same ETELID_SERVICE_KEY value used by every other system in this codebase
# (EtelID wp-config.php, EtelGroup/delivery/EtelTaxi/EtelGebeya .env / config.php).
ETELID_SERVICE_KEY=CHANGE_ME
ETELID_BASE_URL=https://ethelmarket.com/EtelId

# One MySQL host/user/pass is usually shared across all DBs on this cPanel account;
# only the DB name differs per system. Override host/user/pass per system below if needed.
DB_HOST=localhost
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

ETELID_DB_NAME=CHANGE_ME
ETELID_DB_PREFIX=Etelid_

ETELGROUP_DB_NAME=CHANGE_ME

ETELPAY_DB_NAME=CHANGE_ME
ETELPAY_DB_PREFIX=Etelpay_

DELIVERY_DB_NAME=CHANGE_ME

ETELTAXI_DB_NAME=CHANGE_ME

ETELGEBEYA_DB_NAME=CHANGE_ME

ETELMADEYA_DB_NAME=CHANGE_ME
