# Local Claude Code tooling files - not part of the application
.claude/*
# ...except skills, which are shared project capabilities meant to be
# available to any session/contributor working on this repo.
!.claude/skills/
.claude/skills/**/__pycache__/
.claude/skills/**/.coverage
.claude/skills/**/*.pyc

# Local Impeccable design-review tooling snapshots - not part of the app
.impeccable/

# Real secrets belong on the live server only, never in git -- a committed
# .env is what an earlier session's zip upload overwrote a working live
# .env with (real DB password + service keys clobbered by this file's
# committed CHANGE_ME placeholders). Each system keeps a .env.example
# instead, documenting which keys it needs without ever risking a real
# deploy overwriting live secrets with placeholders again.
**/.env

# Runtime debug logs - EtelGebeya's storage/debug.log was found committed
# (12KB+ of accumulated request paths/timestamps) during the company-wide
# audit; a log file is generated data, not source, and shouldn't ship in
# a deploy zip or sit in a public repo regardless of what it happens to
# contain today.
**/storage/debug.log
**/storage/*.log
