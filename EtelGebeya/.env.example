# EtelGebeya .env TEMPLATE -- safe to commit, contains no real secrets.
# Copy this to .env on the live server and fill in real values there --
# .env itself is gitignored and must never be committed (see .gitignore).
# See config/app.php for how each of these is consumed.
DB_HOST=localhost
DB_NAME=EtelGebeya
DB_USER=EtelGebeya
DB_PASS=CHANGE_ME
ADMIN_SECRET=CHANGE_ME
# Separate, higher-entropy secret for updater.php (arbitrary file upload/
# overwrite under the webroot) -- falls back to ADMIN_SECRET if unset, but
# a leaked dashboard credential shouldn't also grant that. Set this to a
# different value than ADMIN_SECRET.
UPDATER_SECRET=CHANGE_ME
EG_ETELPAY_SECRET=CHANGE_ME
TOKEN_SECRET=CHANGE_ME
ETEL_OS_KEY=CHANGE_ME
# Read by audit_agent.php (and its delivery/ counterpart) - must match
# AUDIT_SECRET in audit/config.php and public/config.php, and the
# client-side PROXY_SECRET in audit/index.html + public/index.html.
ETEL_AUDIT_SECRET=CHANGE_ME
GOOGLE_MAPS_API_KEY=CHANGE_ME
ETELID_SERVICE_KEY=CHANGE_ME
TELEBIRR_MERCHANT_ID=your_merchant_id
TELEBIRR_API_KEY=your_api_key
TELEBIRR_SECRET_KEY=your_secret_key
ABYSINIA_MERCHANT_ID=your_abysinia_merchant_id
ABYSINIA_API_KEY=your_abysinia_api_key
ABYSINIA_ACCOUNT_NO=your_abysinia_account_number
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_ACCOUNT_NO=your_cbe_account_number
FCM_SERVER_KEY=your_fcm_server_key
AT_API_KEY=your_key_from_africastalking.com
AT_USERNAME=your_at_username
TG_BOT_TOKEN=CHANGE_ME
TG_BOT_NAME=EtelDeliveryRideBot
# Required: must also be passed as secret_token when calling Telegram's setWebhook,
# otherwise telegram_webhook.php will reject every incoming update (401).
TG_WEBHOOK_SECRET=CHANGE_ME
ETELID_SERVICE_URL=https://ethelmarket.com/EtelId/wp-json/etelid/v1
ETEL_PAY_SECRET=CHANGE_ME
UPDATER_PASSWORD=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME

VAPID_PRIVATE_KEY_PEM=CHANGE_ME

VAPID_SUBJECT=mailto:CHANGE_ME
