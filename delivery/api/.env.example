# ETEL Delivery & Ride .env TEMPLATE -- safe to commit, contains no real secrets.
# Copy this to api/.env on the live server and fill in real values there --
# api/.env itself is gitignored and must never be committed.
#
# Generate a random secret for any *_SECRET/*_KEY value with, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"

DB_HOST=localhost
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# Signs auth tokens issued by api/boot.php - changing this invalidates all
# existing sessions.
TOKEN_SECRET=CHANGE_ME

# Shared secret for the api/etel-os.php connector endpoint.
ETEL_OS_KEY=CHANGE_ME

# Legacy shared key some older endpoints check via ETELID_KEY - keep this
# in sync with whatever the corresponding etel-api.php-style integration
# expects on the other end.
ETELID_LEGACY_KEY=CHANGE_ME

# Cross-system SSO - same value configured in EtelID's wp-config.php as
# ETELID_SERVICE_KEY.
ETELID_SERVICE_KEY=CHANGE_ME
ETELID_SERVICE_URL=https://ethelmarket.com/EtelId/wp-json/etelid/v1

GOOGLE_MAPS_API_KEY=CHANGE_ME

# Payment gateways - fill in only the ones actually enabled.
TELEBIRR_MERCHANT_ID=CHANGE_ME
TELEBIRR_API_KEY=CHANGE_ME
TELEBIRR_SECRET_KEY=CHANGE_ME
ABYSINIA_MERCHANT_ID=CHANGE_ME
ABYSINIA_API_KEY=CHANGE_ME
ABYSINIA_ACCOUNT_NO=CHANGE_ME
CBE_MERCHANT_ID=CHANGE_ME
CBE_ACCOUNT_NO=CHANGE_ME
ETEL_PAY_SECRET=CHANGE_ME

# Push notifications
FCM_SERVER_KEY=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY_PEM=CHANGE_ME
VAPID_SUBJECT=mailto:CHANGE_ME

# SMS (Africa's Talking)
AT_API_KEY=CHANGE_ME
AT_USERNAME=CHANGE_ME

# Telegram notifications bot
TG_BOT_TOKEN=CHANGE_ME
TG_BOT_NAME=CHANGE_ME
TG_WEBHOOK_SECRET=CHANGE_ME

# Admin file-upload Updater tool password (see UPDATER_README.md)
UPDATER_PASSWORD=CHANGE_ME

# Shared secret with EtelGebeya/audit/proxy.php's AUDIT_SECRET, for the
# one-click self-audit tool (api/audit_agent.php) - must match exactly.
ETEL_AUDIT_SECRET=CHANGE_ME

# CDN/cache purge + cron dispatch guards
PURGE_CACHE_SECRET=CHANGE_ME
CRON_DISPATCH_KEY=CHANGE_ME
